# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financeiro

# JWT & Security
SECRET_KEY=sua-chave-secreta-super-segura-min-32-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://seu-frontend.vercel.app

# Email (para recuperação de senha)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=csv,pdf,xlsx

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Supabase (opcional se usar Edge Functions)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-supabase
